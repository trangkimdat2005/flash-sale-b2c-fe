# =====================================================================
# Flash Sale B2C - Frontend Production env (TEMPLATE)
# =====================================================================
# File nay la MAU tham khao cho viec build Docker image frontend tren
# VPS. KHONG chua gia tri that - dung lam template cho deploy repo
# (deploy-b2c-utc2/docker/frontend.Dockerfile).
#
# Build prod tren VPS (da reverse-proxy qua Nginx cung origin):
#   docker build \
#     --build-arg NEXT_PUBLIC_API_URL=/api/v1 \
#     --build-arg NEXT_PUBLIC_WS_URL= \
#     -f deploy-b2c-utc2/docker/frontend.Dockerfile .
#
# Ten bien PHAI khop code FE:
#   - src/lib/api/client.ts doc process.env.NEXT_PUBLIC_API_URL
#   - src/lib/stomp.ts    doc process.env.NEXT_PUBLIC_WS_URL
# Neu sai ten, Next.js se inline undefined vao bundle, FE fallback ve
# http://localhost:8080 -> trang trang tren trinh duyet user.
# =====================================================================

# ── Backend API base path (KHONG co origin, chi path) ──────────────
# Qua Nginx reverse proxy cung host (http://<VPS_IP>) dung relative
# path /api/v1. Nginx se proxy /api/* sang backend:8080.
NEXT_PUBLIC_API_URL=/api/v1

# ── WebSocket URL (SockJS) ─────────────────────────────────────────
# De trong → SockJS tu dung window.location.host, se ra
# ws(s)://<current-host>/ws. Tranh sai khi doi domain/IP.
# Neu can hard-code (vd test local dev), set day du:
#   NEXT_PUBLIC_WS_URL=http://localhost:8080/ws
NEXT_PUBLIC_WS_URL=

# ── Mock data ─────────────────────────────────────────────────────
# false = goi backend that. Backend phai len truoc.
NEXT_PUBLIC_USE_MOCK=false

# ── Site URL public (dung cho SEO, Open Graph) ────────────────────
NEXT_PUBLIC_SITE_URL=https://<your-domain>

# ── Locale mac dinh (vi | en) ─────────────────────────────────────
NEXT_PUBLIC_DEFAULT_LOCALE=vi